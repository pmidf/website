# Variáveis de ambiente do site PMI-DF.
#
# Copie para `.env.local` no desenvolvimento (que o git ignora) e cadastre as
# mesmas em Vercel → Settings → Environment Variables, marcando o ambiente
# Production. Variável criada ou alterada no painel só vale a partir do
# PRÓXIMO deploy: depois de mexer, clique em Redeploy.
#
# Nenhuma tem o prefixo NEXT_PUBLIC_: todas ficam no servidor e nunca chegam
# ao navegador.

# --- Agenda de eventos (src/lib/sympla.ts) ------------------------------------
# Token da API do Sympla. Sem ele, a agenda de /eventos aparece vazia, com link
# para a página do capítulo no Sympla.
SYMPLA_TOKEN=

# Segredo do POST /api/eventos/revalidate, que força a agenda a se atualizar
# na hora. Sem ele, o endpoint fica desligado.
SYMPLA_REVALIDATE_SECRET=

# --- Formulário de contato (src/app/(site)/contato/enviar.ts) -----------------
# Conta que envia os e-mails. É também o remetente: o Gmail recusa remetente
# diferente da conta autenticada.
SMTP_USER=

# No Gmail/Google Workspace, NÃO é a senha normal da conta: é uma "senha de
# app" de 16 letras (Conta Google → Segurança → Verificação em duas etapas →
# Senhas de app). A senha normal é recusada com EAUTH 535.
SMTP_PASS=

# Caixa que recebe as mensagens do formulário.
CONTACT_TO=

# Opcionais. Padrão: Gmail com SSL (smtp.gmail.com, porta 465).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
